  "license": "ISC",
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "tinyrainbow": "^3.2.0"
  }
}
