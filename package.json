{
  "name": "onion",
  "version": "1.0.0",
  "description": "Discord bot built to protect your server with powerful moderation and security tools.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "node src/scripts/deploy-commands.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "prepare": "husky"
  },
  "keywords": [
